Package: baycnts
Type: Package
Title: Bayesian Inference for Causal Networks
Version: 2.0.0
Authors@R: c(person(given = c("Evan", "A"),
                      family = "Martin",
                      role = c("aut")),
               person(given = "Venkata",
                      family = "Patchigolla",
